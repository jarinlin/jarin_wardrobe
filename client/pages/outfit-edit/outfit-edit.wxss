.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 12rpx;
}

.label {
  color: var(--text-secondary);
}

.value {
  font-weight: 600;
}

.clothes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.cloth {
  background: var(--surface);
  border-radius: var(--radius);
  overflow: hidden;
  border: 3rpx solid transparent;
  box-shadow: var(--shadow);
}

.cloth.selected {
  border-color: var(--accent);
}

.cloth-cover {
  height: 160rpx;
  background: #e8e2d8;
}

.cloth-cover image,
.ph {
  width: 100%;
  height: 100%;
}

.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.cloth-name {
  display: block;
  padding: 12rpx;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo image {
  width: 100%;
  height: 100%;
}

.muted {
  color: var(--text-muted);
}
