<view class="page settings">
  <view class="section">
    <text class="section-title">运行信息</text>
    <view class="row">
      <text class="k">模式</text>
      <text class="v">{{modeLabel}}（{{runMode}}）</text>
    </view>
    <view class="row" wx:if="{{runMode === 'local'}}">
      <text class="k">API</text>
      <text class="v mono">{{baseUrl}}</text>
    </view>
    <text class="tip">在 src/assets/js/config.js 切换 mock / local / cloud；后端微信登录由 WX_APPID 与 ALLOW_MOCK_LOGIN 控制。</text>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="onClearCache">
      <text class="menu-label">清除本地缓存</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-label">关于 Jarin衣柜</text>
      <text class="arrow">→</text>
    </view>
  </view>
</view>
