<view class="page wardrobe">
  <view class="head anim-rise">
    <text class="head-title">我的衣柜</text>
    <text class="head-sub">按分类浏览与管理衣物</text>
  </view>

  <view class="toolbar">
    <view class="search-box">
      <input
        class="search-input"
        placeholder="搜索名称 / 品牌 / 颜色"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="loadList"
      />
    </view>
    <view class="add-btn" bindtap="goAdd">＋</view>
  </view>

  <scroll-view class="cat-scroll" scroll-x enable-flex>
    <view
      class="chip {{activeCategoryId === 0 ? 'active' : ''}}"
      data-id="0"
      bindtap="onCategoryTap"
    >全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="chip {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
    <view class="chip manage" bindtap="goCategory">管理</view>
  </scroll-view>

  <view class="grid" wx:if="{{list.length}}">
    <view
      class="card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      style="animation-delay: {{index * 40}}ms"
    >
      <view class="cover tone-{{index % 4}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="cover-ph">
          <text class="ph-cat">{{item.categoryName || '衣物'}}</text>
          <text class="ph-name">{{item.name}}</text>
        </view>
      </view>
      <view class="meta">
        <text class="name">{{item.name}}</text>
        <text class="sub">{{item.color || '未填色'}} · {{item.wearCount || 0}} 次</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-title">衣柜还是空的</view>
    <view class="muted">拍一张照片，添加第一件衣物</view>
    <view class="btn-primary empty-btn" bindtap="goAdd">添加衣物</view>
  </view>
</view>
