.cover {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: var(--shadow);
}

.cover-hover {
  opacity: 0.92;
}

.cover-img,
.cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--ink-soft);
  font-weight: 600;
  background: #f6f3f1;
}

.plus {
  font-size: 56rpx;
  line-height: 1;
  color: var(--coral-deep);
}

.cover-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

.analyzing-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  background: rgba(31, 29, 36, 0.55);
}

.meal-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.meal-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--ink-soft);
  font-size: 24rpx;
  border: 2rpx solid var(--line);
}

.meal-chip.on {
  background: var(--accent-soft);
  color: var(--coral-deep);
  border-color: rgba(232, 93, 117, 0.25);
  font-weight: 600;
}

.form {
  padding: 28rpx;
  margin-bottom: 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow);
}

.items-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.total-kcal {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--coral-deep);
}

.item-row {
  padding: 18rpx 0 8rpx;
  border-top: 1rpx solid var(--line);
}

.item-row:first-of-type {
  border-top: none;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-idx {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-soft);
}

.item-del {
  font-size: 22rpx;
  color: var(--coral-deep);
}

.item-grid {
  display: flex;
  gap: 16rpx;
}

.item-grid .form-item {
  flex: 1;
  min-width: 0;
}

.form-item.compact {
  margin-bottom: 12rpx;
}

.add-item {
  margin-top: 8rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--coral-deep);
  border-top: 1rpx dashed var(--line);
}

.advice-block {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.del {
  margin-top: 20rpx;
}
