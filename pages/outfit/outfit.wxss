.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 32rpx;
  gap: 24rpx;
}

.head-btn {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--coral);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 24rpx rgba(232, 93, 117, 0.2);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(31, 29, 36, 0.05);
  box-shadow: var(--shadow);
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.item-date {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}

.item-count {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--mint-deep);
  background: var(--moss-soft);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.item-clothes {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cloth-line {
  font-size: 24rpx;
  color: var(--ink);
  background: #f6f3f1;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 400;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}
