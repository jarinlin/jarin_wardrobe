<view class="page mine">
  <view class="hero anim-rise" bindtap="onProfileTap">
    <image class="avatar" src="{{userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill" />
    <view class="info">
      <text class="name">{{userInfo.nickname || '未登录'}}</text>
      <text class="desc">{{loggedIn ? '管理分类、标签与数据' : '点击登录同步衣柜'}}</text>
    </view>
  </view>

  <view class="stats anim-rise-delay">
    <view class="stat">
      <text class="num">{{stats.total || 0}}</text>
      <text class="label">衣物</text>
    </view>
    <view class="stat">
      <text class="num">{{statsValue}}</text>
      <text class="label">总价值</text>
    </view>
    <view class="stat wide">
      <text class="num sm">{{mostWorn}}</text>
      <text class="label">最高使用</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goDiet">
      <text class="menu-label">饮食记录</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goBody">
      <text class="menu-label">身体档案</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goCategory">
      <text class="menu-label">分类管理</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goTags">
      <text class="menu-label">标签管理</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onSettings">
      <text class="menu-label">设置</text>
      <text class="arrow">→</text>
    </view>
  </view>

  <view class="btn-ghost logout" wx:if="{{loggedIn}}" bindtap="onLogout">退出登录</view>
</view>
