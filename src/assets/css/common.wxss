.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 56rpx;
  position: relative;
}

.page-title {
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  color: var(--ink);
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}

.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
}

.section-action {
  font-size: 24rpx;
  color: var(--coral-deep);
  font-weight: 500;
}

.surface {
  background: var(--paper);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--radius-lg);
  background: var(--coral);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 28rpx rgba(232, 93, 117, 0.22);
}

.btn-primary.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(232, 93, 117, 0.28);
  color: var(--coral-deep);
  font-size: 28rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.85);
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: var(--radius-lg);
  background: rgba(224, 84, 84, 0.1);
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 500;
}

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink-soft);
  margin-bottom: 14rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--ink-soft);
  font-size: 24rpx;
  border: 2rpx solid var(--line);
}

.chip.active {
  background: var(--accent-soft);
  color: var(--coral-deep);
  border-color: rgba(232, 93, 117, 0.22);
  font-weight: 500;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  font-weight: 500;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 24rpx 26rpx;
  background: #fff;
  border-radius: var(--radius);
  border: 2rpx solid rgba(31, 29, 36, 0.08);
  color: var(--ink);
  font-size: 30rpx;
  font-family: var(--font);
}

.form-textarea {
  min-height: 160rpx;
}

.safe-bottom {
  height: calc(28rpx + env(safe-area-inset-bottom));
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.anim-rise {
  animation: rise-in 0.45s var(--ease) both;
}

.anim-rise-delay {
  animation: rise-in 0.5s var(--ease) 0.06s both;
}

.anim-fade {
  animation: rise-in 0.4s var(--ease) both;
}

.anim-pop {
  animation: pop-in 0.4s var(--ease) both;
}
