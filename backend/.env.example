PORT=3000
# 对外访问根地址（拼媒体代理链接；本地可写 http://127.0.0.1:3000，真机改局域网 IP）
PUBLIC_BASE_URL=http://127.0.0.1:3000
JWT_SECRET=change_me

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=jarin_wardrobe
DB_ADMIN_DATABASE=postgres
# 应用连接会 SET TIME ZONE Asia/Shanghai；库内 TIMESTAMPTZ 仍按 UTC 存瞬时

WX_APPID=
WX_SECRET=
ALLOW_MOCK_LOGIN=true

# 腾讯云 COS（对象存储；常被称作腾讯云 OSS）
# 控制台：https://console.cloud.tencent.com/cos
COS_SECRET_ID=
COS_SECRET_KEY=
# 形如 bucket-appid，例如 jarin-1250000000
COS_BUCKET=
# 地域，例如 ap-guangzhou / ap-shanghai
COS_REGION=ap-guangzhou
# 对象键前缀
COS_PREFIX=wardrobe
# 可选：自定义 CDN / 加速域名（不填则用默认 cos 域名）
COS_CDN_DOMAIN=

# AI 衣物识别（OpenAI 兼容中转）
AI_BASE_URL=https://open.lastoken.cn/v1
AI_API_KEY=
AI_MODEL=qwen3.5-plus
AI_TIMEOUT_SEC=60
