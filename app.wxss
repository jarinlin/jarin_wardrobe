@import './src/assets/css/theme.wxss';
@import './src/assets/css/common.wxss';

page {
  background-color: var(--bg);
  background-image: linear-gradient(180deg, #fbf8f6 0%, #f7f3f0 55%, #f4f8f6 100%);
  color: var(--ink);
  font-family: var(--font);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.55;
  min-height: 100%;
  box-sizing: border-box;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

/* 避免 page 的 line-height 压扁 input/textarea 文字 */
input {
  line-height: normal;
}

textarea {
  line-height: 1.5;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: inherit;
  font-family: inherit;
}

button::after {
  border: none;
}
