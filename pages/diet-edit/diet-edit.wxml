<view class="page edit">
  <view class="photos surface">
    <scroll-view class="photo-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="photo-row">
        <view class="photo-card" wx:for="{{form.imageUrls}}" wx:key="*this">
          <image class="photo-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewImage" />
          <text class="photo-del" data-index="{{index}}" catchtap="onRemoveImage">×</text>
        </view>
        <view class="photo-add" wx:if="{{form.imageUrls.length < 9}}" bindtap="onChooseImage">
          <text class="plus">＋</text>
          <text>{{form.imageUrls.length ? '再拍一张' : '拍照识别'}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="analyzing-mask" wx:if="{{analyzing}}" catchtap="noop">AI 识别中…</view>
  </view>

  <view class="skip-photo" wx:if="{{!form.imageUrls.length}}" bindtap="onSkipPhoto">不拍照，直接手填菜品</view>

  <view class="meal-row">
    <view
      class="meal-chip {{form.mealType === item.value ? 'on' : ''}}"
      wx:for="{{mealTypes}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onMealType"
    >{{item.label}}</view>
  </view>

  <view class="form surface">
    <view class="items-head">
      <text class="form-label">本餐菜品</text>
      <text class="total-kcal">合计 {{totals.calories || 0}} 大卡</text>
    </view>
    <view class="meal-totals" wx:if="{{totals.proteinG || totals.carbsG || totals.fatG}}">
      <text>蛋白 {{totals.proteinG || 0}}g</text>
      <text>碳水 {{totals.carbsG || 0}}g</text>
      <text>脂肪 {{totals.fatG || 0}}g</text>
    </view>

    <view class="item-row" wx:for="{{form.items}}" wx:key="index" wx:for-index="index">
      <view class="item-top">
        <text class="item-idx">第 {{index + 1}} 道</text>
        <text class="item-del" data-index="{{index}}" catchtap="onRemoveItem">删除</text>
      </view>
      <view class="form-item compact">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="如：番茄炒蛋" placeholder-class="form-placeholder" value="{{item.foodName}}" data-index="{{index}}" data-key="foodName" bindinput="onItemInput" />
      </view>
      <view class="item-grid">
        <view class="form-item compact">
          <text class="form-label">分量</text>
          <view class="portion-box">
            <input class="form-input portion-input" placeholder="1个" placeholder-class="form-placeholder" value="{{item.portion}}" data-index="{{index}}" data-key="portion" bindinput="onItemInput" />
            <view class="kcal-ai busy" wx:if="{{item.estimating}}">…</view>
            <view class="kcal-ai" wx:else data-index="{{index}}" catchtap="onEstimatePortion">估</view>
          </view>
        </view>
        <view class="form-item compact">
          <text class="form-label">热量</text>
          <view class="kcal-box">
            <input class="form-input kcal-input" type="digit" placeholder="0" placeholder-class="form-placeholder" value="{{item.calories}}" data-index="{{index}}" data-key="calories" bindinput="onItemInput" />
            <text class="kcal-unit">大卡</text>
            <view class="kcal-ai busy" wx:if="{{item.estimating}}">…</view>
            <view class="kcal-ai" wx:else data-index="{{index}}" catchtap="onEstimateCalories">估</view>
          </view>
        </view>
      </view>
      <view class="more-toggle" data-index="{{index}}" bindtap="onToggleNutrients">{{item.expanded ? '收起营养' : '更多营养'}}</view>
      <view class="nutrient-grid" wx:if="{{item.expanded}}">
        <view class="form-item compact">
          <text class="form-label">蛋白质 g</text>
          <input class="form-input" type="digit" placeholder="—" value="{{item.proteinG}}" data-index="{{index}}" data-key="proteinG" bindinput="onItemInput" />
        </view>
        <view class="form-item compact">
          <text class="form-label">碳水 g</text>
          <input class="form-input" type="digit" placeholder="—" value="{{item.carbsG}}" data-index="{{index}}" data-key="carbsG" bindinput="onItemInput" />
        </view>
        <view class="form-item compact">
          <text class="form-label">脂肪 g</text>
          <input class="form-input" type="digit" placeholder="—" value="{{item.fatG}}" data-index="{{index}}" data-key="fatG" bindinput="onItemInput" />
        </view>
        <view class="form-item compact">
          <text class="form-label">总糖 g</text>
          <input class="form-input" type="digit" placeholder="—" value="{{item.sugarG}}" data-index="{{index}}" data-key="sugarG" bindinput="onItemInput" />
        </view>
        <view class="form-item compact">
          <text class="form-label">钠 mg</text>
          <input class="form-input" type="digit" placeholder="—" value="{{item.sodiumMg}}" data-index="{{index}}" data-key="sodiumMg" bindinput="onItemInput" />
        </view>
        <view class="form-item compact">
          <text class="form-label">纤维 g</text>
          <input class="form-input" type="digit" placeholder="—" value="{{item.fiberG}}" data-index="{{index}}" data-key="fiberG" bindinput="onItemInput" />
        </view>
      </view>
    </view>

    <view class="add-item" bindtap="onAddItem">＋ 添加一道</view>

    <view class="form-item advice-block">
      <view class="advice-head">
        <text class="form-label">饮食建议</text>
        <text class="advice-action {{advising ? 'busy' : ''}}" bindtap="onGenerateAdvice">{{form.advice ? '重新生成' : '生成建议'}}</text>
      </view>
      <text class="advice-tip" wx:if="{{form.advice}}">{{form.advice}}</text>
      <text class="advice-empty" wx:else>拍完或填完菜品后可生成提示</text>
    </view>
  </view>

  <view class="btn-primary" bindtap="onSubmit">{{id ? '保存修改' : '保存记录'}}</view>
  <view class="btn-danger del" wx:if="{{id}}" bindtap="onDelete">删除记录</view>
  <view class="safe-bottom"></view>
</view>
