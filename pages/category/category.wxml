<view class="page category">
  <view class="hint">默认分类可改名，也可新增自定义分类</view>

  <view class="list surface">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <text class="name">{{item.name}}</text>
      <view class="ops">
        <text class="op" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onRename">改名</text>
        <text class="op danger" data-id="{{item.id}}" bindtap="onDelete">删除</text>
      </view>
    </view>
    <view class="empty-inline" wx:if="{{!list.length}}">暂无分类</view>
  </view>

  <view class="add-bar">
    <input
      class="add-input"
      placeholder="输入分类名称"
      placeholder-class="add-placeholder"
      value="{{newName}}"
      maxlength="20"
      confirm-type="done"
      bindinput="onInput"
      bindconfirm="onAdd"
    />
    <view class="add-btn {{!newName ? 'disabled' : ''}}" bindtap="onAdd">添加</view>
  </view>
</view>
