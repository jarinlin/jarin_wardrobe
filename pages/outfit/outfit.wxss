@import '../../src/assets/css/ootd.wxss';

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 32rpx;
  gap: 24rpx;
}

.head-btn {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--coral);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 24rpx rgba(232, 93, 117, 0.2);
}

.look-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.look-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: var(--shadow);
}

.look-hover {
  opacity: 0.92;
}

.look-cover {
  position: relative;
  height: 420rpx;
  background: #f6f3f1;
}

.look-photo,
.look-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.look-mosaic {
  display: grid;
  gap: 4rpx;
  background: #efe8e3;
}

.look-mosaic.n0,
.look-mosaic.n1 {
  grid-template-columns: 1fr;
}

.look-mosaic.n2 {
  grid-template-columns: 1fr 1fr;
}

.look-mosaic.n3,
.look-mosaic.n4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.look-mosaic.n3 .look-cell:first-child {
  grid-row: 1 / 3;
}

.look-cell {
  position: relative;
  min-height: 0;
  overflow: hidden;
  background: #f6f3f1;
}

.look-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink-soft);
  text-align: center;
}

.look-ph-empty {
  grid-column: 1 / -1;
}

.look-more {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 29, 36, 0.42);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.look-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 56rpx 24rpx 20rpx;
  background: linear-gradient(180deg, rgba(31, 29, 36, 0) 0%, rgba(31, 29, 36, 0.5) 100%);
}

.look-date {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}

.look-pub {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  line-height: 44rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--coral-deep);
  font-size: 22rpx;
  font-weight: 600;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}
