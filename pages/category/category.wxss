.category {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.hint {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.list {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 90, 122, 0.08);
}

.item:last-child {
  border-bottom: none;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.op {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--coral);
  font-weight: 600;
  line-height: 1.2;
}

.op.danger {
  color: var(--danger);
}

.empty-inline {
  padding: 64rpx 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

/* 底部添加条：固定高度，避免 input placeholder 被 padding 压扁 */
.add-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(31, 29, 36, 0.1);
  box-sizing: border-box;
}

.add-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f7f5f3;
  border-radius: 20rpx;
  border: 2rpx solid rgba(31, 29, 36, 0.06);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 80rpx;
}

.add-placeholder {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 80rpx;
}

.add-btn {
  flex-shrink: 0;
  width: 148rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: var(--coral);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(232, 93, 117, 0.22);
}

.add-btn.disabled {
  opacity: 0.45;
  box-shadow: none;
}
