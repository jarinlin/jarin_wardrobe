.cover {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: var(--shadow);
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--ink-soft);
  font-weight: 600;
  background: #f6f3f1;
}

.plus {
  font-size: 56rpx;
  line-height: 1;
  color: var(--coral-deep);
}

.cover-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

.analyzing-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: rgba(31, 29, 36, 0.55);
}

.meal-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.meal-chip {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--ink-soft);
  font-size: 24rpx;
  border: 2rpx solid var(--line);
}

.meal-chip.on {
  background: var(--accent-soft);
  color: var(--coral-deep);
  border-color: rgba(232, 93, 117, 0.25);
  font-weight: 600;
}

.form {
  padding: 28rpx;
  margin-bottom: 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow);
}

.del {
  margin-top: 20rpx;
}
