.settings {
  padding-bottom: 48rpx;
}

.section {
  margin-bottom: 28rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.section-title {
  display: block;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.k {
  color: var(--muted);
  flex-shrink: 0;
}

.v {
  color: var(--ink);
  text-align: right;
  word-break: break-all;
}

.v.mono {
  font-size: 22rpx;
}

.tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.55;
}

.menu {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 90, 122, 0.08);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.arrow {
  color: var(--muted);
  font-size: 28rpx;
}
