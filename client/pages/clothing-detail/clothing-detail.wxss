.cover {
  height: 420rpx;
  margin: -32rpx -28rpx 24rpx;
  background: linear-gradient(160deg, #e8e2d8, #d9e4de);
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  letter-spacing: 8rpx;
  color: var(--text-secondary);
}

.body {
  padding: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 28rpx;
}

.rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.row.block {
  flex-direction: column;
}

.k {
  color: var(--text-muted);
  font-size: 26rpx;
}

.v {
  color: var(--text);
  font-size: 26rpx;
  text-align: right;
}

.row.block .v {
  text-align: left;
  margin-top: 8rpx;
  line-height: 1.6;
}

.actions {
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
