.diet-ai {
  display: block;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.55;
}

.diet-ai-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: var(--accent-soft);
  color: var(--coral-deep);
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  vertical-align: middle;
}

.week-7 {
  display: block;
  margin: -8rpx 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}
