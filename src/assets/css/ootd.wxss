.seg {
  display: flex;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #efe8e3;
}

.seg-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink-soft);
  font-weight: 500;
}

.seg-item.on {
  background: #fff;
  color: var(--coral-deep);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(40, 28, 36, 0.06);
}

.plaza-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.plaza-chip {
  height: 60rpx;
  padding: 0 26rpx;
  line-height: 60rpx;
  border-radius: 18rpx;
  background: #efe8e3;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 500;
}

.plaza-chip.on {
  background: var(--accent-soft);
  color: var(--coral-deep);
  font-weight: 600;
}

.mag-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-shadow: var(--shadow);
  animation: rise-in 0.45s var(--ease) both;
}

.mag-card.mag-hero {
  margin-bottom: 0;
}

.mag-cover {
  position: relative;
  height: 440rpx;
  background: #f6f3f1;
}

.mag-hero .mag-cover {
  height: 500rpx;
}

.mag-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.rank-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 2;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 12rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: var(--coral);
  color: #fff;
}

.rank-badge.r2 {
  background: var(--ink);
  color: #fff;
}

.rank-badge.r3 {
  background: rgba(255, 255, 255, 0.94);
  color: var(--ink);
}

.rank-badge.inline {
  position: static;
  flex-shrink: 0;
}

.mag-cover-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 48rpx 20rpx 16rpx;
  background: linear-gradient(180deg, rgba(31, 29, 36, 0) 0%, rgba(31, 29, 36, 0.55) 100%);
}

.mag-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #efe8e3;
}

.mag-cover-bar .mag-avatar {
  border: 2rpx solid rgba(255, 255, 255, 0.7);
}

.mag-nick {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mag-nick-light {
  color: #fff;
}

.mag-text {
  padding: 24rpx 28rpx 28rpx;
}

.mag-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.mag-quote {
  display: block;
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.45;
  margin-bottom: 18rpx;
}

.mag-below {
  padding: 22rpx 28rpx 26rpx;
}

.mag-caption {
  display: block;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.55;
}

.mag-items {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mag-item {
  font-size: 22rpx;
  color: var(--ink);
  background: #f6f3f1;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.like-btn {
  flex-shrink: 0;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: auto !important;
  min-width: 88rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.like-btn::after {
  border: none;
}

.like-press {
  opacity: 0.86;
}

.like-btn.on {
  background: var(--accent-soft);
  color: var(--coral-deep);
  font-weight: 600;
}

.mag-author .like-btn {
  background: #f6f3f1;
}

.mag-author .like-btn.on {
  background: var(--accent-soft);
}

.like-heart-wrap {
  position: relative;
  width: 28rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.like-heart {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  transform: rotate(45deg);
  opacity: 0.45;
}

.like-heart::before,
.like-heart::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
}

.like-heart::before {
  left: -7rpx;
  top: 0;
}

.like-heart::after {
  left: 0;
  top: -7rpx;
}

.like-btn.on .like-heart {
  opacity: 1;
}

.like-cta {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100% !important;
  height: 92rpx;
  margin-top: 8rpx;
  border-radius: var(--radius-lg);
  background: #f6f3f1;
  color: var(--ink-soft);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
}

.like-cta::after {
  border: none;
}

.like-cta.on {
  background: var(--accent-soft);
  color: var(--coral-deep);
  font-weight: 600;
}

.like-cta .like-heart {
  opacity: 0.5;
}

.like-cta.on .like-heart {
  opacity: 1;
}

.preview-kicker {
  margin: 28rpx 0 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: var(--muted);
}

.preview-caption {
  width: 100%;
  min-height: 88rpx;
  margin-bottom: 14rpx;
  padding: 0;
  border: none;
  background: transparent;
  font-size: 28rpx;
  font-family: var(--font);
  color: var(--ink);
  line-height: 1.55;
}

.preview-caption.quote {
  min-height: 120rpx;
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.45;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 24rpx 0 28rpx;
}

.choice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow);
}

.choice.off {
  opacity: 0.5;
}

.choice-thumb {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: #f6f3f1;
}

.choice-thumb.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.choice-thumb.lines {
  padding: 0 16rpx;
  gap: 10rpx;
}

.mark-line {
  width: 100%;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(232, 93, 117, 0.28);
}

.mark-line.short {
  width: 58%;
  align-self: flex-start;
}

.choice-thumb.chips {
  padding: 0 14rpx;
  gap: 8rpx;
}

.mark-chip {
  width: 72%;
  height: 18rpx;
  border-radius: 8rpx;
  background: rgba(232, 93, 117, 0.2);
}

.mark-chip.short {
  width: 46%;
}

.choice-copy {
  flex: 1;
  min-width: 0;
}

.opt-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.opt-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
}

.hint-empty {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--coral-deep);
  line-height: 1.45;
}

.withdraw-btn {
  margin-top: 16rpx;
}

.plaza-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 0 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow);
}

.plaza-switch switch {
  flex-shrink: 0;
}
