.login {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(ellipse at 80% 0%, rgba(61, 107, 90, 0.18), transparent 50%),
    linear-gradient(180deg, #ebe6de, #f3f0eb);
}

.panel {
  width: 100%;
  padding: 48rpx 20rpx;
  text-align: center;
}

.brand {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.slogan {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 64rpx;
  line-height: 1.7;
}

.profile {
  margin-bottom: 48rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ddd6cb;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
}

.nickname {
  width: 420rpx;
  margin: 0 auto;
  padding: 20rpx;
  background: var(--surface);
  border-radius: var(--radius);
  text-align: center;
}

.tip {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
