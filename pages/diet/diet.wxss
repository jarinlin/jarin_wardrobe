.page.diet {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 28rpx;
  gap: 24rpx;
}

.head-btn {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--coral);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 24rpx rgba(232, 93, 117, 0.2);
}

.metrics {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
}

.week-summary {
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
}

.week-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
  gap: 16rpx;
}

.week-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.week-sub {
  font-size: 22rpx;
  color: var(--muted);
}

.week-nums {
  display: flex;
  gap: 12rpx;
}

.week-bar {
  margin-top: 20rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #efe8e3;
  overflow: hidden;
}

.week-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--coral), #f0a3b0);
}

.week-bar-fill.over {
  background: linear-gradient(90deg, #c43d3d, var(--coral));
}

.m-num.over {
  color: var(--coral-deep);
}

.week-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--coral-deep);
  line-height: 1.45;
}

.meal-hint {
  margin: -8rpx 0 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--accent-soft);
  color: var(--coral-deep);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.45;
}

.metrics-row {
  display: flex;
  gap: 12rpx;
}

.m {
  flex: 1;
  text-align: center;
}

.m-num {
  display: block;
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 500;
  color: var(--ink);
}

.m-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.metrics-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--coral-deep);
}

.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.date-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.date-pick {
  font-size: 24rpx;
  color: var(--coral-deep);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--shadow);
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #f3f0ee;
}

.thumb.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 28rpx;
}

.meta {
  flex: 1;
  min-width: 0;
}

.meta-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.meal {
  font-size: 22rpx;
  color: var(--coral-deep);
  font-weight: 600;
}

.kcal {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

.food {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.portion {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.muted {
  font-size: 24rpx;
  color: var(--muted);
}
