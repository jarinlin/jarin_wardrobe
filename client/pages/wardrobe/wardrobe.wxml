<view class="page wardrobe">
  <view class="toolbar">
    <view class="search-box">
      <input
        class="search-input"
        placeholder="搜索名称 / 品牌 / 颜色"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="loadList"
      />
    </view>
    <view class="add-btn" bindtap="goAdd">＋</view>
  </view>

  <scroll-view class="cat-scroll" scroll-x enable-flex>
    <view
      class="chip {{activeCategoryId === 0 ? 'active' : ''}}"
      data-id="0"
      bindtap="onCategoryTap"
    >全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="chip {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
    <view class="chip manage" bindtap="goCategory">管理</view>
  </scroll-view>

  <view class="grid" wx:if="{{list.length}}">
    <view
      class="card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="card-cover">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="cover-placeholder">
          <text>{{item.categoryName || '衣物'}}</text>
        </view>
      </view>
      <view class="card-body">
        <text class="card-name">{{item.name}}</text>
        <text class="card-meta">{{item.color || '—'}} · 穿 {{item.wearCount || 0}} 次</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-title">衣柜还是空的</view>
    <view class="muted">拍一张照片，开始收录第一件衣服</view>
    <view class="btn-primary empty-btn" bindtap="goAdd">添加衣物</view>
  </view>
</view>
