.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 32rpx;
  gap: 24rpx;
}

.head-btn {
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item {
  padding: 28rpx 30rpx;
}

.item-date {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.item-clothes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pill {
  padding: 10rpx 18rpx;
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.item-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.muted {
  color: var(--text-muted);
  font-size: 22rpx;
}

.link {
  color: var(--accent);
  font-size: 24rpx;
}
