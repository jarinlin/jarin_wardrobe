.settings {
  padding-bottom: 48rpx;
}

.section {
  margin-bottom: 28rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.section-title {
  display: block;
  font-family: var(--font-display);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.avatar-btn {
  width: 112rpx !important;
  height: 112rpx !important;
  min-width: 112rpx;
  max-width: 112rpx;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f3f0ee !important;
  border: none;
  line-height: 1 !important;
  display: block;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  display: block;
}

.profile-fields {
  flex: 1;
  min-width: 0;
}

.nickname {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f7f3f0;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.nickname-placeholder {
  color: var(--muted);
}

.profile-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.45;
}

.profile-guest {
  padding: 8rpx 0 4rpx;
}

.save-btn {
  margin-top: 24rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--coral);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn.disabled {
  opacity: 0.65;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.k {
  color: var(--muted);
  flex-shrink: 0;
}

.v {
  color: var(--ink);
  text-align: right;
  word-break: break-all;
}

.v.mono {
  font-size: 22rpx;
}

.tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.55;
}

.menu {
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 90, 122, 0.08);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.arrow {
  color: var(--muted);
  font-size: 28rpx;
}

.logout {
  margin-top: 32rpx;
}
