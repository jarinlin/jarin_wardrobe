.cover {
  height: 420rpx;
  margin: -28rpx -32rpx 28rpx;
  background: #fceef1;
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.body {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 28rpx;
}

.rows {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.row.block {
  flex-direction: column;
}

.k {
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 600;
}

.v {
  color: var(--ink);
  font-size: 26rpx;
  text-align: right;
  font-weight: 600;
}

.row.block .v {
  text-align: left;
  margin-top: 8rpx;
  line-height: 1.6;
}

.actions {
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
