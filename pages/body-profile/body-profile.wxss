.tip {
  margin-bottom: 28rpx;
}

.picker {
  color: var(--ink);
}

.age-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.metrics {
  padding: 28rpx;
  margin-bottom: 32rpx;
  border-radius: 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(31, 29, 36, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.k {
  font-size: 26rpx;
  color: var(--muted);
}

.v {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}
