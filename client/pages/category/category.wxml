<view class="page category">
  <view class="page-subtitle" style="margin-bottom: 24rpx;">默认分类可改名，也可新增自定义分类</view>

  <view class="list surface">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <text class="name">{{item.name}}</text>
      <view class="ops">
        <text class="op" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onRename">改名</text>
        <text class="op danger" data-id="{{item.id}}" bindtap="onDelete">删除</text>
      </view>
    </view>
  </view>

  <view class="add-row">
    <input class="form-input" placeholder="新分类名称" value="{{newName}}" bindinput="onInput" />
    <view class="btn-primary add-btn" bindtap="onAdd">添加</view>
  </view>
</view>
