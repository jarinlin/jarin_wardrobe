<view class="page detail" wx:if="{{!loggedIn}}">
  <view class="empty">
    <view class="empty-title">登录后查看穿搭详情</view>
    <view class="muted">登录后可查看、分享并管理穿搭记录</view>
    <view class="btn-primary" bindtap="goLogin">去登录</view>
  </view>
</view>

<view class="page detail" wx:elif="{{item}}">
  <view class="head">
    <view class="date">{{dateLabel}}</view>
    <view class="count">这套穿搭使用 {{item.wearCount || 1}} 次 · {{clothesCount}} 件单品</view>
    <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
  </view>

  <image wx:if="{{item.imageUrl}}" class="photo" src="{{item.imageUrl}}" mode="aspectFill" />

  <view class="section">
    <view class="section-title">包含衣物</view>
    <view class="list">
      <view class="cloth" wx:for="{{item.clothes}}" wx:for-item="c" wx:key="id">
        <view class="cover">
          <image wx:if="{{c.imageUrl}}" src="{{c.imageUrl}}" mode="aspectFill" />
          <view wx:else class="ph">{{c.categoryName}}</view>
        </view>
        <view class="info">
          <text class="name">{{c.name}}</text>
          <text class="meta">{{c.color || '—'}} · {{c.brand || '—'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="share-row">
    <button class="share-btn primary" open-type="share">分享给好友</button>
    <view class="share-btn ghost" bindtap="onCopyShare">复制文案</view>
  </view>

  <view class="btn-primary plaza-btn" bindtap="goPublish">{{item.ootdPublished ? '管理广场帖' : '发布到广场'}}</view>

  <view class="actions">
    <view class="btn-ghost" bindtap="onEdit">编辑</view>
    <view class="btn-danger" bindtap="onDelete">删除</view>
  </view>
</view>
