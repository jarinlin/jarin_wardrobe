<view class="page body" wx:if="{{booted}}">
  <view class="page-subtitle tip">BMI 与基础代谢按公式估算；体脂和每日营养建议由 AI 结合身体档案生成，失败时使用公式兜底</view>

  <view class="form surface">
    <view class="form-item">
      <text class="form-label">性别</text>
      <view class="gender-row">
        <view class="g {{form.gender==='male'?'on':''}}" data-v="male" bindtap="onGender">男</view>
        <view class="g {{form.gender==='female'?'on':''}}" data-v="female" bindtap="onGender">女</view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">出生日期</text>
      <picker mode="date" value="{{form.birthDate || endDate}}" start="{{startDate}}" end="{{endDate}}" bindchange="onBirthChange">
        <view class="form-input picker">{{form.birthDate ? birthLabel : '请选择出生日期'}}</view>
      </picker>
      <text class="age-hint" wx:if="{{form.age}}">当前 {{form.age}} 岁（按生日自动计算）</text>
    </view>
    <view class="form-item">
      <text class="form-label">身高 (cm)</text>
      <input class="form-input" type="digit" placeholder="如：165" placeholder-class="form-placeholder" value="{{form.heightCm}}" data-key="heightCm" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">体重 (kg)</text>
      <input class="form-input" type="digit" placeholder="如：52" placeholder-class="form-placeholder" value="{{form.weightKg}}" data-key="weightKg" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">平均每日活动量</text>
      <view class="chip-grid">
        <view class="g {{form.activityLevel==='sedentary'?'on':''}}" data-v="sedentary" bindtap="onActivity">久坐办公</view>
        <view class="g {{form.activityLevel==='light'?'on':''}}" data-v="light" bindtap="onActivity">轻度活动</view>
        <view class="g {{form.activityLevel==='moderate'?'on':''}}" data-v="moderate" bindtap="onActivity">中度活动</view>
        <view class="g {{form.activityLevel==='heavy'?'on':''}}" data-v="heavy" bindtap="onActivity">重度活动</view>
      </view>
      <text class="age-hint" wx:if="{{activityHint}}">{{activityHint}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">目标</text>
      <view class="chip-grid three">
        <view class="g {{form.goal==='cut'?'on':''}}" data-v="cut" bindtap="onGoal">减脂</view>
        <view class="g {{form.goal==='maintain'?'on':''}}" data-v="maintain" bindtap="onGoal">维持</view>
        <view class="g {{form.goal==='bulk'?'on':''}}" data-v="bulk" bindtap="onGoal">增肌</view>
      </view>
      <text class="age-hint" wx:if="{{goalHint}}">{{goalHint}}</text>
    </view>
  </view>

  <view class="metrics surface" wx:if="{{metrics.bmi}}">
    <view class="row"><text class="k">BMI</text><text class="v">{{metrics.bmi}}（{{metrics.bmiLevel}}）</text></view>
    <view class="row" wx:if="{{metrics.bodyFatPct}}">
      <text class="k">{{metrics.bodyFatSource === 'ai' ? 'AI 体脂估算' : '体脂估算'}}</text>
      <text class="v">{{metrics.bodyFatText || (metrics.bodyFatPct + '%')}}</text>
    </view>
    <view class="row"><text class="k">理想体重</text><text class="v">{{metrics.idealWeightKg}} kg</text></view>
    <view class="row"><text class="k">基础代谢</text><text class="v">{{metrics.bmr}} kcal</text></view>
    <view class="row"><text class="k">建议热量</text><text class="v">{{metrics.suggestKcal}} kcal/日</text></view>
    <view class="row" wx:for="{{targetRows}}" wx:key="key">
      <text class="k">{{item.label}} · {{item.roleHint}}</text>
      <text class="v">{{item.value}} {{item.unit}}</text>
    </view>
    <text class="metrics-note">体脂为 AI 结合年龄、性别、BMI 与活动量给出的区间估算，并非体测结果；AI 不可用时采用公式估算。总糖仅为参考，不是添加糖上限。</text>
  </view>

  <view class="btn-primary" bindtap="onSave">保存档案</view>
</view>
