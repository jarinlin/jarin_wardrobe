<view class="page home">
  <view class="hero anim-rise">
    <view class="brand-row">
      <view class="brand-names">
        <text class="brand">Jarin</text>
        <text class="brand-cn">衣柜</text>
      </view>
      <view class="home-avatar-wrap" bindtap="onAvatarTap">
        <image class="home-avatar" src="{{userInfo.avatarUrl || defaultAvatar}}" mode="aspectFill" />
      </view>
    </view>
    <text class="tagline">你好，{{userInfo.nickname || '访客'}} · 整理衣物，记录今天的穿搭和饮食</text>

    <view class="cta" bindtap="goWardrobe">
      <view class="cta-text">
        <text class="cta-main">打开衣柜</text>
        <text class="cta-sub">已收录 {{stats.total || 0}} 件</text>
      </view>
      <text class="cta-go">→</text>
    </view>
  </view>

  <view class="alerts anim-rise-delay" wx:if="{{loggedIn && alerts.length}}">
    <view
      class="alert-item"
      wx:for="{{alerts}}"
      wx:key="id"
      data-action="{{item.action}}"
      bindtap="onAlertTap"
    >{{item.text}}</view>
  </view>

  <view class="diet-strip surface anim-rise-delay" wx:if="{{loggedIn}}" bindtap="goDiet">
    <view class="diet-head">
      <text class="diet-title">今日热量</text>
      <text class="diet-go">{{diet.sub || '去记录'}} →</text>
    </view>
    <view class="diet-nums">
      <view class="m">
        <text class="m-num">{{diet.suggestDay || '—'}}</text>
        <text class="m-label">建议日摄入</text>
      </view>
      <view class="m">
        <text class="m-num">{{diet.todayKcal}}</text>
        <text class="m-label">今日摄入</text>
      </view>
      <view class="m">
        <text class="m-num {{diet.remainClass}}">{{diet.remainText}}</text>
        <text class="m-label">{{diet.remainLabel}}</text>
      </view>
    </view>
    <view class="diet-ai" wx:if="{{diet.aiAdvice}}">
      <text class="diet-ai-tag">AI 生成</text>
      <text class="diet-ai-text">{{diet.aiAdvice}}</text>
    </view>
  </view>

  <view class="suggest anim-rise-delay" wx:if="{{loggedIn}}">
    <view class="section-head">
      <text class="section-title">今日建议</text>
      <text class="section-action" bindtap="onRefreshSuggest">{{suggestActionLabel}}</text>
    </view>

    <view class="weather-line" wx:if="{{weather}}">
      <text class="w-city">{{weather.city || '本地'}}</text>
      <text class="w-main">{{weather.weather}} {{weather.temperature}}℃</text>
      <text class="w-sub">{{suggest.seasonHint}}</text>
    </view>
    <view class="weather-line muted" wx:elif="{{suggest.weatherNote}}">{{suggest.weatherNote}}</view>
    <view class="loc-action" wx:if="{{locationHint && !weather}}" bindtap="onRefreshSuggest">开启定位获取天气</view>

    <view class="suggest-reason" wx:if="{{suggest.reason}}">{{suggest.reason}}</view>
    <view class="suggest-tips" wx:if="{{suggest.tips}}">{{suggest.tips}}</view>

    <scroll-view class="suggest-scroll" scroll-x show-scrollbar="{{false}}" wx:if="{{suggest.items.length}}">
      <view class="suggest-row">
        <view
          class="suggest-card"
          wx:for="{{suggest.items}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goClothing"
        >
          <image wx:if="{{item.imageUrl}}" class="suggest-cover" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="suggest-cover ph">{{item.categoryName}}</view>
          <text class="suggest-name">{{item.name}}</text>
          <text class="suggest-cat">{{item.categoryName}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="suggest-empty" wx:elif="{{!suggestLoading}}">
      <text class="muted">衣柜里还没有可匹配的单品，先添加几件有标签的衣物</text>
      <text class="loc-action" bindtap="goWardrobe">去衣柜添加</text>
    </view>

    <view class="suggest-actions" wx:if="{{suggest.items.length}}">
      <view class="btn-ghost suggest-btn" bindtap="goOutfitFromSuggest">记为今日穿搭</view>
    </view>
  </view>

  <view class="panel anim-rise-delay">
    <view class="section-head">
      <text class="section-title">今日穿搭</text>
      <text class="section-action" bindtap="goOutfitEdit">{{todayOutfit ? '查看' : '去记录'}}</text>
    </view>

    <view class="today" wx:if="{{todayOutfit}}" bindtap="goOutfitDetail">
      <view class="today-date">{{todayLabel}}</view>
      <view class="today-tags">
        <text wx:for="{{todayOutfit.clothes}}" wx:key="id" class="tag">{{item.name}}</text>
        <text wx:if="{{!todayOutfit.clothes.length}}" class="muted">尚未添加衣物</text>
      </view>
      <text class="today-foot">穿搭次数 · {{todayOutfit.wearCount || 1}}</text>
    </view>

    <view class="today empty-today" wx:else bindtap="goOutfitEdit">
      <text class="empty-line">今天还没记录穿搭</text>
      <text class="muted">从衣柜选几件，记下今天的搭配</text>
    </view>

    <view class="stats">
      <view class="stat coral" bindtap="goWardrobe">
        <text class="num">{{stats.total || 0}}</text>
        <text class="label">衣物</text>
      </view>
      <view class="stat mint">
        <text class="num">{{statsValue}}</text>
        <text class="label">总价值</text>
      </view>
      <view class="stat lemon" bindtap="goOutfit">
        <text class="num">{{outfitCount}}</text>
        <text class="label">穿搭</text>
      </view>
    </view>

    <view class="login-bar" wx:if="{{!loggedIn}}" bindtap="goLogin">
      <text>登录后同步你的衣柜</text>
      <text class="login-go">去登录</text>
    </view>
  </view>
</view>
