.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text);
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-action {
  font-size: 24rpx;
  color: var(--accent);
}

.surface {
  background: var(--surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--text);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary.disabled {
  opacity: 0.45;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  color: var(--text);
  font-size: 30rpx;
  background: transparent;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: rgba(181, 74, 58, 0.1);
  color: var(--danger);
  font-size: 30rpx;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--text-muted);
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg-elevated);
  color: var(--text-secondary);
  font-size: 24rpx;
  border: 2rpx solid transparent;
}

.chip.active {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: rgba(61, 107, 90, 0.25);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 24rpx 28rpx;
  background: var(--bg-elevated);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 28rpx;
}

.form-textarea {
  min-height: 160rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
