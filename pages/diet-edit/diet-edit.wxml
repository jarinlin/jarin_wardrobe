<view class="page edit">
  <view class="cover surface" hover-class="cover-hover" bindtap="onChooseImage">
    <image wx:if="{{form.imageUrl}}" class="cover-img" src="{{form.imageUrl}}" mode="aspectFill" />
    <view wx:else class="cover-empty">
      <text class="plus">＋</text>
      <text>拍照识别（可选）</text>
      <text class="cover-hint">忘拍照也可直接手填菜名和热量</text>
    </view>
    <!-- 识别中全覆盖并拦截点击，避免误触；未识别时不渲染 -->
    <view class="analyzing-mask" wx:if="{{analyzing}}" catchtap="noop">AI 识别中…</view>
  </view>

  <view class="skip-photo" wx:if="{{!form.imageUrl}}" bindtap="onSkipPhoto">不拍照，直接手填菜品</view>

  <view class="meal-row">
    <view
      class="meal-chip {{form.mealType === item.value ? 'on' : ''}}"
      wx:for="{{mealTypes}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onMealType"
    >{{item.label}}</view>
  </view>

  <view class="form surface">
    <view class="items-head">
      <text class="form-label">本餐菜品</text>
      <text class="total-kcal">合计 {{totalCalories}} 大卡</text>
    </view>

    <view class="item-row" wx:for="{{form.items}}" wx:key="index" wx:for-index="index">
      <view class="item-top">
        <text class="item-idx">第 {{index + 1}} 道</text>
        <text class="item-del" data-index="{{index}}" catchtap="onRemoveItem">删除</text>
      </view>
      <view class="form-item compact">
        <text class="form-label">名称</text>
        <input class="form-input" placeholder="如：番茄炒蛋" placeholder-class="form-placeholder" value="{{item.foodName}}" data-index="{{index}}" data-key="foodName" bindinput="onItemInput" />
      </view>
      <view class="item-grid">
        <view class="form-item compact">
          <text class="form-label">分量</text>
          <input class="form-input" placeholder="约150g" placeholder-class="form-placeholder" value="{{item.portion}}" data-index="{{index}}" data-key="portion" bindinput="onItemInput" />
        </view>
        <view class="form-item compact">
          <text class="form-label">热量</text>
          <view class="kcal-box">
            <input class="form-input kcal-input" type="digit" placeholder="0" placeholder-class="form-placeholder" value="{{item.calories}}" data-index="{{index}}" data-key="calories" bindinput="onItemInput" />
            <text class="kcal-unit">大卡</text>
            <view class="kcal-ai busy" wx:if="{{item.estimating}}">…</view>
            <view class="kcal-ai" wx:else data-index="{{index}}" catchtap="onEstimateCalories">估</view>
          </view>
        </view>
      </view>
    </view>

    <view class="add-item" bindtap="onAddItem">＋ 添加一道</view>

    <view class="form-item advice-block" wx:if="{{showAdvice}}">
      <text class="form-label">饮食建议</text>
      <textarea class="form-textarea" placeholder="AI 建议可改" placeholder-class="form-textarea-placeholder" value="{{form.advice}}" bindinput="onAdviceInput" />
    </view>
  </view>

  <view class="btn-primary" bindtap="onSubmit">{{id ? '保存修改' : '保存记录'}}</view>
  <view class="btn-danger del" wx:if="{{id}}" bindtap="onDelete">删除记录</view>
  <view class="safe-bottom"></view>
</view>
