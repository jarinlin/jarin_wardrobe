.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
}

.label {
  color: var(--muted);
  font-weight: 600;
}

.value {
  font-weight: 500;
  color: var(--coral-deep);
}

.clothes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.cloth {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-shadow: var(--shadow);
}

.cloth.selected {
  border-color: var(--coral);
  box-shadow: 0 10rpx 24rpx rgba(232, 93, 117, 0.18);
}

.cloth-cover {
  height: 160rpx;
  background: #f6f3f1;
}

.cloth-cover image,
.ph {
  width: 100%;
  height: 100%;
}

.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 700;
}

.cloth-name {
  display: block;
  padding: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 28rpx;
  background: #eaf7f2;
  box-shadow: var(--shadow);
}

.photo image {
  width: 100%;
  height: 100%;
}

.muted {
  color: var(--muted);
  font-weight: 600;
}
