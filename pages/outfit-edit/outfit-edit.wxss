@import '../../src/assets/css/ootd.wxss';

.date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: var(--shadow);
}

.label {
  color: var(--muted);
  font-weight: 600;
}

.value {
  font-weight: 500;
  color: var(--coral-deep);
}

.clothes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.cloth {
  overflow: hidden;
  border-radius: 22rpx;
  background: #fff;
  border: 4rpx solid transparent;
  box-shadow: var(--shadow);
}

.cloth-hover {
  opacity: 0.94;
}

.cloth.selected {
  border-color: var(--coral);
  background: #fff8f9;
}

.cloth-cover {
  position: relative;
  height: 210rpx;
  background: #f6f3f1;
}

.cloth-cover image,
.ph {
  width: 100%;
  height: 100%;
}

.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 600;
  text-align: center;
}

.cloth-mark {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--coral);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check {
  width: 16rpx;
  height: 9rpx;
  margin-top: -4rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.cloth-name {
  display: block;
  padding: 12rpx 10rpx 14rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cloth.selected .cloth-name {
  color: var(--coral-deep);
  font-weight: 600;
}

.photo {
  height: 360rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #f6f3f1;
  border: 2rpx dashed rgba(232, 93, 117, 0.28);
  box-sizing: border-box;
}

.photo-hover {
  opacity: 0.92;
}

.photo.has-photo {
  border: none;
  box-shadow: var(--shadow);
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.plus {
  font-size: 56rpx;
  line-height: 1;
  color: var(--coral-deep);
}

.note-item {
  margin-top: 12rpx;
}

.note-area {
  min-height: 112rpx;
}
