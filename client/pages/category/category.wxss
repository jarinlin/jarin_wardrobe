.list {
  overflow: hidden;
  margin-bottom: 32rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.item:last-child {
  border-bottom: none;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
}

.ops {
  display: flex;
  gap: 28rpx;
}

.op {
  font-size: 26rpx;
  color: var(--accent);
}

.op.danger {
  color: var(--danger);
}

.add-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-row .form-input {
  flex: 1;
}

.add-btn {
  width: 160rpx;
  flex-shrink: 0;
}
