.list {
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 90, 122, 0.08);
}

.item:last-child {
  border-bottom: none;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
}

.ops {
  display: flex;
  gap: 28rpx;
}

.op {
  font-size: 24rpx;
  color: var(--coral);
  font-weight: 700;
}

.op.danger {
  color: var(--danger);
}

.add-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.add-row .form-input {
  flex: 1;
  background: #fff;
}

.add-btn {
  width: 160rpx;
  height: 88rpx;
  flex-shrink: 0;
}
