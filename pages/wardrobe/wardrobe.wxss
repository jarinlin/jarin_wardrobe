.wardrobe {
  padding-top: 12rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 22rpx;
}

.search-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-lg);
  padding: 0 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--line);
  box-shadow: var(--shadow);
}

.search-input {
  width: 100%;
  height: 76rpx;
  padding: 0;
  line-height: 76rpx;
  font-size: 28rpx;
  font-family: var(--font);
  color: var(--ink);
}

.search-placeholder {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 76rpx;
}

.add-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  background: var(--coral);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(232, 93, 117, 0.22);
}

.tag-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx 0 20rpx;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: #fceef1;
}

.tag-filter-label {
  font-size: 24rpx;
  color: var(--coral-deep);
  font-weight: 500;
}

.tag-filter-clear {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 500;
}

/* 横向滚动：内层 inline-flex，避免 enable-flex + gap 在真机错位 */
.cat-scroll {
  width: 100%;
  margin-bottom: 28rpx;
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 4rpx 6rpx;
}

.cat-chip {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 26rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  background: #efe8e3;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 60rpx;
  text-align: center;
}

.cat-chip.on {
  background: var(--accent-soft);
  color: var(--coral-deep);
  font-weight: 600;
}

.cat-manage {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 22rpx;
  margin-right: 4rpx;
  border-radius: 18rpx;
  background: var(--moss-soft);
  color: var(--mint-deep);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 60rpx;
  text-align: center;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
  animation: rise-in 0.45s var(--ease) both;
}

.cover {
  height: 300rpx;
}

.cover.tone-0 {
  background: #fceef1;
}

.cover.tone-1 {
  background: #eaf7f2;
}

.cover.tone-2 {
  background: #faf4df;
}

.cover.tone-3 {
  background: #eef2fa;
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-ph {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
}

.ph-cat {
  font-size: 22rpx;
  color: var(--muted);
}

.ph-name {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  text-align: center;
}

.meta {
  padding: 18rpx 20rpx 22rpx;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  font-size: 22rpx;
  color: var(--muted);
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.empty-btn {
  margin-top: 32rpx;
}
