<view class="page settings">
  <view class="section profile-section">
    <text class="section-title">个人资料</text>
    <view class="profile-row" wx:if="{{loggedIn}}">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl || defaultAvatar}}" mode="aspectFill" />
      </button>
      <view class="profile-fields">
        <input
          class="nickname"
          type="nickname"
          placeholder="填写昵称"
          placeholder-class="nickname-placeholder"
          value="{{nickname}}"
          bindblur="onNickname"
          bindinput="onNickname"
          bindchange="onNickname"
        />
        <text class="profile-tip">点头像更换；保存后同步到服务端</text>
      </view>
    </view>
    <view class="profile-guest" wx:else>
      <text class="profile-tip">登录后可修改昵称与头像</text>
    </view>
    <view
      class="save-btn {{savingProfile ? 'disabled' : ''}}"
      wx:if="{{loggedIn}}"
      bindtap="onSaveProfile"
    >{{savingProfile ? '保存中…' : '保存资料'}}</view>
  </view>

  <view class="section">
    <text class="section-title">运行信息</text>
    <view class="row">
      <text class="k">模式</text>
      <text class="v">{{modeLabel}}（{{runMode}}）</text>
    </view>
    <view class="row" wx:if="{{runMode === 'local'}}">
      <text class="k">API</text>
      <text class="v mono">{{baseUrl}}</text>
    </view>
    <text class="tip">在 src/assets/js/config.js 切换 mock / local / cloud；后端微信登录由 WX_APPID 与 ALLOW_MOCK_LOGIN 控制。</text>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="onExport">
      <text class="menu-label">{{exporting ? '导出中…' : '导出衣柜数据'}}</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onClearCache">
      <text class="menu-label">清除本地缓存</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-label">关于 Jarin衣柜</text>
      <text class="arrow">→</text>
    </view>
  </view>
</view>
