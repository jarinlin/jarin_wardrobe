<view class="page detail" wx:if="{{item}}">
  <view class="head surface">
    <view class="date">{{dateLabel}}</view>
    <view class="count">这套穿搭使用 {{item.wearCount || 1}} 次</view>
    <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
  </view>

  <image wx:if="{{item.imageUrl}}" class="photo" src="{{item.imageUrl}}" mode="aspectFill" />

  <view class="section">
    <view class="section-title">包含衣物</view>
    <view class="list">
      <view class="cloth surface" wx:for="{{item.clothes}}" wx:key="id">
        <view class="cover">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="ph">{{item.categoryName}}</view>
        </view>
        <view class="info">
          <text class="name">{{item.name}}</text>
          <text class="meta">{{item.color || '—'}} · {{item.brand || '—'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="btn-danger" bindtap="onDelete">删除这条穿搭</view>
</view>
