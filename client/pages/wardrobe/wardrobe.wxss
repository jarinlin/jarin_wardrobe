.wardrobe {
  padding-top: 24rpx;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-box {
  flex: 1;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow);
}

.search-input {
  width: 100%;
  font-size: 26rpx;
}

.add-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--text);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}

.cat-scroll {
  white-space: nowrap;
  margin-bottom: 28rpx;
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.chip.manage {
  border: 2rpx dashed var(--line);
  background: transparent;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.card-cover {
  height: 280rpx;
  background: linear-gradient(160deg, #e8e2d8, #d9e4de);
}

.card-cover image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.card-body {
  padding: 20rpx 22rpx 24rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  font-size: 22rpx;
  color: var(--text-muted);
}

.muted {
  color: var(--text-muted);
  font-size: 24rpx;
}

.empty-btn {
  margin: 32rpx auto 0;
  width: 280rpx;
}
