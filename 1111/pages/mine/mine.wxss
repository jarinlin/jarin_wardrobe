.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background: #fff;
  border: 1rpx solid rgba(31, 29, 36, 0.05);
  box-shadow: var(--shadow);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  border: 3rpx solid #fff;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 500;
}

.desc {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-soft);
}

.stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1.1fr 1.3fr;
  gap: 12rpx;
}

.stat {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 22rpx 14rpx;
  box-shadow: var(--shadow);
}

.num {
  display: block;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.num.sm {
  font-size: 26rpx;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.label {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 400;
}

.menu {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.arrow {
  color: var(--muted);
  font-size: 28rpx;
  font-weight: 500;
}

.logout {
  margin-top: 40rpx;
}
