<view class="page wardrobe">
  <view class="toolbar anim-rise">
    <view class="search-box">
      <input
        class="search-input"
        placeholder="搜索名称 / 品牌 / 颜色"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="loadList"
      />
    </view>
    <view class="add-btn" bindtap="goAdd">＋</view>
  </view>

  <scroll-view class="cat-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        class="cat-chip {{activeCategoryId === 0 ? 'on' : ''}}"
        data-id="0"
        bindtap="onCategoryTap"
      >全部</view>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat-chip {{activeCategoryId === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
      <view class="cat-manage" bindtap="goCategory">管理</view>
    </view>
  </scroll-view>

  <scroll-view class="cat-scroll status-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        wx:for="{{statusChips}}"
        wx:key="id"
        class="cat-chip status-chip {{activeStatus === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onStatusTap"
      >{{item.label}}</view>
      <view class="cat-manage" bindtap="goTags">打标中心</view>
    </view>
  </scroll-view>

  <scroll-view class="cat-scroll" scroll-x show-scrollbar="{{false}}" wx:if="{{occasionChips.length}}">
    <view class="cat-row">
      <view
        wx:for="{{occasionChips}}"
        wx:key="name"
        class="cat-chip occasion-chip {{activeTag === item.name ? 'on' : ''}}"
        data-tag="{{item.name}}"
        bindtap="onOccasionTap"
      >{{item.name}} · {{item.count}}</view>
    </view>
  </scroll-view>

  <view class="tag-filter" wx:if="{{activeTag && !occasionChips.length}}">
    <text class="tag-filter-label">标签 · {{activeTag}}</text>
    <text class="tag-filter-clear" bindtap="clearTag">清除</text>
  </view>
  <view class="tag-filter soft" wx:elif="{{activeTag}}">
    <text class="tag-filter-label">场合/季节 · {{activeTag}}</text>
    <text class="tag-filter-clear" bindtap="clearTag">清除</text>
  </view>

  <view class="retag-hint" wx:if="{{showRetagHint}}" bindtap="goTags">
    当前筛选含待处理衣物，去打标中心批量重打 →
  </view>

  <view class="grid" wx:if="{{list.length}}">
    <view
      class="card"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
      style="animation-delay: {{index * 40}}ms"
    >
      <view class="cover tone-{{index % 4}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="cover-ph">
          <text class="ph-cat">{{item.categoryName || '衣物'}}</text>
          <text class="ph-name">{{item.name}}</text>
        </view>
        <view class="status-badge" wx:if="{{item.showStatusBadge}}">
          {{item.statusLabel}}
        </view>
      </view>
      <view class="meta">
        <text class="name">{{item.name}}</text>
        <text class="sub">{{item.color || '未填色'}} · {{item.wearCount || 0}} 次</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-title">没有匹配的衣物</view>
    <view class="muted">试试换分类、打标状态或场合标签</view>
    <view class="btn-primary empty-btn" bindtap="goAdd">添加衣物</view>
  </view>
</view>
