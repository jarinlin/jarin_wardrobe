.login {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  background-color: var(--bg);
  background-image: linear-gradient(180deg, #fbf8f6 0%, #f7f3f0 55%, #f4f8f6 100%);
}

.panel {
  width: 100%;
  text-align: center;
}

.brand {
  display: block;
  font-family: var(--font-display);
  font-size: 56rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
  color: var(--ink);
}

.slogan {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink-soft);
  margin-bottom: 72rpx;
  line-height: 1.7;
}

.profile {
  margin-bottom: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 外层固定圆形，避免 button 默认 100% 宽被拉成椭圆 */
.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 36rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  border: 4rpx solid rgba(232, 93, 117, 0.22);
  box-shadow: var(--shadow);
  flex-shrink: 0;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  min-width: 160rpx;
  min-height: 160rpx;
  max-width: 160rpx;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f0ed;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  display: block;
  border-radius: 50%;
}

.avatar-hint {
  display: block;
  margin: -12rpx 0 28rpx;
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.nickname-wrap {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

.nickname {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 36rpx;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: center;
  font-size: 30rpx;
  font-family: var(--font);
  color: var(--ink);
  box-sizing: border-box;
}

.tip {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
