.cover {
  height: 360rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--text-secondary);
  background: linear-gradient(160deg, #e8e2d8, #d9e4de);
}

.plus {
  font-size: 56rpx;
  line-height: 1;
}

.form {
  padding: 28rpx 28rpx 8rpx;
  margin-bottom: 40rpx;
}

.picker {
  color: var(--text);
}
