<view class="page diet">
  <view class="head anim-rise">
    <view>
      <view class="page-title">饮食记录</view>
      <view class="page-subtitle" wx:if="{{!loggedIn}}">登录后记录每天的饮食</view>
      <view class="page-subtitle" wx:elif="{{!bodyReady}}">先完善身体档案，才能记饮食</view>
    </view>
    <view class="head-btn" wx:if="{{loggedIn && bodyReady}}" bindtap="goCreate">记一餐</view>
  </view>

  <view wx:if="{{!loggedIn}}" class="gate surface anim-rise-delay">
    <view class="gate-title">登录后即可记饮食</view>
    <view class="muted">登录后可记录餐食，并查看每日热量与营养建议。</view>
    <view class="btn-primary gate-btn" bindtap="goLogin">去登录</view>
  </view>

  <view wx:elif="{{bodyChecked && !bodyReady}}" class="gate surface anim-rise-delay">
    <view class="gate-title">先完善身体档案</view>
    <view class="muted">记饮食需要身高、体重，才能估算热量和每日营养建议。填写后即可拍照或手填记一餐。</view>
    <view class="btn-primary gate-btn" bindtap="goBody">去填写档案</view>
  </view>

  <block wx:if="{{bodyReady}}">
    <view class="metrics surface anim-rise-delay" bindtap="goBody">
      <view class="metrics-row">
        <view class="m">
          <text class="m-num">{{metrics.bmi || '—'}}</text>
          <text class="m-label">BMI {{metrics.bmiLevel || ''}}</text>
        </view>
        <view class="m">
          <text class="m-num">{{bodyFatText}}</text>
          <text class="m-label">体脂区间</text>
        </view>
        <view class="m">
          <text class="m-num">{{todayKcal}}</text>
          <text class="m-label">今日摄入</text>
        </view>
      </view>
      <text class="metrics-tip">{{metricsTip}}</text>
    </view>

    <view class="week-summary surface anim-rise-delay">
      <view class="week-head">
        <text class="week-title">今日营养</text>
        <text class="week-sub">{{day.sub}}</text>
      </view>
      <view class="week-nums">
        <view class="m">
          <text class="m-num">{{day.suggestDay || '—'}}</text>
          <text class="m-label">建议热量</text>
        </view>
        <view class="m">
          <text class="m-num">{{day.todayKcal}}</text>
          <text class="m-label">今日热量</text>
        </view>
        <view class="m">
          <text class="m-num {{day.remainClass}}">{{day.remainText}}</text>
          <text class="m-label">{{day.remainLabel}}</text>
        </view>
      </view>
      <view class="week-bar" wx:if="{{day.suggestDay}}">
        <view class="{{day.barClass}}" style="width: {{day.ratioPct}}%;"></view>
      </view>
      <text class="week-tip" wx:if="{{day.tip}}">{{day.tip}}</text>
      <text class="incomplete-tip" wx:if="{{day.incompleteTip}}">{{day.incompleteTip}}</text>
      <view class="nutrient-toggle" wx:if="{{day.progress.length}}" bindtap="onToggleNutrients">
        <text>{{nutrientsExpanded ? '收起营养详情' : '展开营养详情'}}</text>
        <text class="nutrient-toggle-icon">{{nutrientsExpanded ? '▴' : '▾'}}</text>
      </view>
      <view class="nutrient-list" wx:if="{{nutrientsExpanded && day.progress.length}}">
        <view class="nutrient-row" wx:for="{{day.progress}}" wx:key="key">
          <view class="nutrient-meta">
            <text class="nutrient-name">{{item.label}}</text>
            <text class="nutrient-role">{{item.roleHint}}</text>
          </view>
          <view class="nutrient-vals">
            <text class="{{item.over ? 'over' : ''}}">{{item.consumedText}}</text>
            <text class="muted"> / {{item.targetText}} {{item.unit}}</text>
          </view>
          <view class="week-bar slim">
            <view class="{{item.over ? 'week-bar-fill over' : 'week-bar-fill'}}" style="width: {{item.ratioPct}}%;"></view>
          </view>
        </view>
      </view>
      <text class="diet-ai" wx:if="{{day.aiAdvice}}">建议：{{day.aiAdvice}}<text class="diet-ai-tag">AI</text></text>
    </view>
    <text class="week-7" wx:if="{{weekLine}}">{{weekLine}}</text>

    <view class="date-row">
      <text class="date-label">{{dateLabel}}</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <text class="date-pick">换日期</text>
      </picker>
    </view>

    <view class="meal-hint" wx:if="{{mealHint}}" bindtap="goCreate">{{mealHint}}</view>

    <view class="list" wx:if="{{list.length}}">
      <view class="item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
        <image wx:if="{{item.imageUrl}}" class="thumb" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        <image wx:else class="thumb" src="{{item.placeholderUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="meta">
          <view class="meta-top">
            <text class="meal">{{item.mealTypeLabel}}</text>
            <text class="kcal">{{item.displayKcal}} 大卡</text>
          </view>
          <text class="food">{{item.displayTitle}}</text>
          <text class="portion">{{item.displaySub}}</text>
          <text class="portion" wx:if="{{item.macroLine}}">{{item.macroLine}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <view class="empty-title">这天还没有记录</view>
    </view>
  </block>
</view>
