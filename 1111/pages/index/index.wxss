.home {
  padding: 24rpx 28rpx 48rpx;
}

.hero {
  padding: 36rpx 8rpx 32rpx;
}

.brand-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.brand {
  font-family: var(--font-display);
  font-size: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.brand-cn {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 500;
  color: var(--coral-deep);
}

.tagline {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink-soft);
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-lg);
  background: var(--coral);
  color: #fff;
  box-shadow: 0 14rpx 36rpx rgba(232, 93, 117, 0.22);
}

.cta-main {
  display: block;
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.cta-sub {
  font-size: 22rpx;
  opacity: 0.88;
  font-weight: 400;
}

.cta-go {
  font-size: 40rpx;
  font-weight: 500;
  opacity: 0.92;
}

.panel {
  margin-top: 8rpx;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(31, 29, 36, 0.05);
  box-shadow: var(--shadow);
}

.today {
  padding: 4rpx 0 8rpx;
}

.today-date {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.today-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: var(--accent-soft);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 400;
}

.today-foot {
  font-size: 22rpx;
  color: var(--mint-deep);
  font-weight: 500;
}

.empty-today {
  padding: 24rpx 4rpx;
}

.empty-line {
  display: block;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  color: var(--ink);
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 400;
}

.stats {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stat {
  border-radius: 20rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  background: #faf8f7;
}

.stat.coral {
  background: #fceef1;
}

.stat.mint {
  background: #eaf7f2;
}

.stat.lemon {
  background: #faf4df;
}

.num {
  display: block;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.label {
  font-size: 20rpx;
  color: var(--muted);
  font-weight: 400;
}

.login-bar {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.login-go {
  color: var(--coral-deep);
  background: var(--accent-soft);
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 500;
}
