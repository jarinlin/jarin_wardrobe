.tags {
  padding-bottom: 48rpx;
}

.status-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.status-action {
  font-size: 24rpx;
  color: var(--coral-deep);
  font-weight: 500;
}

.status-nums {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
  margin-bottom: 14rpx;
}

.status-ops {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.op-btn {
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: var(--coral);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

.op-btn.ghost {
  background: var(--moss-soft);
  color: var(--mint-deep);
}

.failed-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.failed-item {
  font-size: 22rpx;
  color: var(--muted);
}

.hint {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.search-box {
  margin-bottom: 24rpx;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow);
}

.tag-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}

.tag-count {
  font-size: 22rpx;
  color: var(--coral-deep);
  font-weight: 600;
}

.empty {
  padding: 80rpx 16rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-family: var(--font-display);
  font-size: 32rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.muted {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}
