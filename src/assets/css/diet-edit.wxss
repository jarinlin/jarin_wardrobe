.photos {
  position: relative;
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.photo-scroll {
  width: 100%;
  white-space: nowrap;
}

.photo-row {
  display: inline-flex;
  gap: 16rpx;
  align-items: stretch;
}

.photo-card,
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  background: #f6f3f1;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: rgba(31, 29, 36, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.advice-action {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--coral-deep);
}

.advice-action.busy {
  opacity: 0.5;
}

.advice-tip,
.advice-empty {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
}

.advice-tip {
  color: var(--ink);
}

.advice-empty {
  color: var(--muted);
}

.portion-box {
  position: relative;
}

.portion-input {
  padding-right: 88rpx;
}
